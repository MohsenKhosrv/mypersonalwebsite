# Mixpanel project token (Project Settings > Project Token). Public by design; it ships to the browser.
# Put the real value in .env.local for local dev and in Vercel > Project > Settings > Environment Variables.
# Tip: use a separate Mixpanel project/token for Development/Preview and another for Production.
# If empty, all tracking is disabled.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Dev only: log every analytics event to the browser console. With no token this is a dry run (nothing is sent).
NEXT_PUBLIC_ANALYTICS_DEBUG=false
